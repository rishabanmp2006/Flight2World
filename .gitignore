# ---- OS ----
.DS_Store
._*
Thumbs.db

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Test / type / lint caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Pipeline outputs (generated; never commit) ----
# Reconstruction runs are reproducible from data/ + core/ — keep them local.
outputs/
*.log

# ---- Heavy reconstruction artifacts ----
# COLMAP feature databases are tens of MB and fully regenerable.
*.db
*.db-journal

# Generated validation/report HTML
*_validation_report.html

# ---- Editors ----
.idea/
*.swp
*~
# .vscode/settings.json is tracked deliberately (shared editor config).
# Ignore the personal/local files instead:
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Models / weights ----
*.pt
*.pth
*.onnx
*.safetensors
